# Copy to /var/www/mcu-nex/.env on the server and fill in the three marked lines.
# Never commit the real file.
APP_NAME=MCU-NEX
APP_ENV=production
APP_KEY=
# ↑ filled in by: php artisan key:generate (docs/deploy-azure.md, step 10)
APP_DEBUG=false
APP_URL=https://CHANGE-ME.eastasia.cloudapp.azure.com
# ↑ your address, with https://

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcu_nex
DB_USERNAME=mcu_nex
DB_PASSWORD=CHANGE-ME
# ↑ from: cat ~/.mcu-nex-db-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
LEGACY_API_PATH=

# Account emails (confirm email, forgot password). "log" only writes them to storage/logs/laravel.log.
# To really send, use Gmail with an App Password (docs/account-emails.md):
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=the-16-letter-app-password
# MAIL_FROM_ADDRESS=you@gmail.com
# MAIL_FROM_NAME="MCU-NEX"
VITE_APP_NAME="${APP_NAME}"
